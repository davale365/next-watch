# Postgres connection string from Neon (https://neon.tech).
# Format: postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# TMDB v4 API Read Access Token.
# Get one at https://www.themoviedb.org/settings/api after creating a free TMDB account.
TMDB_API_READ_TOKEN=

# PostHog Cloud project API key (https://posthog.com).
# Optional for Phase 0; required by Phase 4 when feedback events are wired up.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
